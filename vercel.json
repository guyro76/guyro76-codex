{
  "framework": "nextjs",
  "installCommand": "cd paprika-app && npm install",
  "buildCommand": "cd paprika-app && npm run build",
  "outputDirectory": "paprika-app/.next",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/reminder-telegram",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/reminder-whatsapp",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/reminder-email",
      "schedule": "30 3 * * *"
    }
  ]
}
