{
  "name": "eretz-ir-go",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ארץ-עיר GO! — משחק ארץ-עיר משפחתי, מקומי, ללא עלויות AI",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:free": "tsc -b && VITE_SUPABASE_URL=https://e2e-free.test VITE_SUPABASE_ANON_KEY=e2e-free vite build --outDir dist-free",
    "preview": "vite preview",
    "preview:free": "vite preview --outDir dist-free",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run build:free && playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "seed:report": "node scripts/seed-report.mjs",
    "native:sync": "npm run build && npx cap sync",
    "native:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@supabase/supabase-js": "^2.112.3",
    "dexie": "^4.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}
