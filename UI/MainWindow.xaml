<Window x:Class="LangFlipDesktop.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="קליקשפה - LangFlip Desktop"
        Width="700"
        Height="900"
        Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#070D1A" Offset="0" />
            <GradientStop Color="#0B1830" Offset="0.5" />
            <GradientStop Color="#0A1226" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2563EB" Offset="0" />
            <GradientStop Color="#38D5FF" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Background" Value="#16233F" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2E4A7A" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                                <Setter Property="BorderBrush" Value="#38D5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="{StaticResource AccentGradient}" />
            <Setter Property="BorderBrush" Value="#38D5FF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="Background" Value="#111D36" />
            <Setter Property="BorderBrush" Value="#22375C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="16,8,16,8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.35" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Margin="0">
            <!-- Header -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,32,0,0">
                <TextBlock Text="קליקשפה" FontSize="48" FontWeight="Bold" TextAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#38D5FF" Offset="0" />
                            <GradientStop Color="#7C9FFF" Offset="1" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <Rectangle Height="3" Width="120" Fill="{StaticResource AccentGradient}" RadiusX="2" RadiusY="2" Margin="0,6,0,0" />
                <TextBlock Text="מתקן, מתרגם ומשפר טקסט בכל מקום במחשב"
                           FontSize="14" Foreground="#BDEFFF" TextAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>

            <!-- Status Card -->
            <Border Style="{StaticResource StatusCard}">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="12" Height="12" Fill="#4FFF00" Margin="8,0,0,0" />
                        <TextBlock Text="האפליקציה פעילה ברקע" Foreground="#BDEFFF" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <TextBlock Text="פעולות מהירות" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="16,16,16,8" />
            <WrapPanel HorizontalAlignment="Center" Margin="8">
                <Button Content="⚡ תיקון חכם" Style="{StaticResource PrimaryButton}" Click="Button_AutoFix" />
                <Button Content="הפוך לעברית" Style="{StaticResource GlassButton}" Click="Button_ConvertHebrew" />
                <Button Content="הפוך לאנגלית" Style="{StaticResource GlassButton}" Click="Button_ConvertEnglish" />
                <Button Content="תרגם לאנגלית" Style="{StaticResource GlassButton}" Click="Button_TranslateEnglish" />
                <Button Content="תרגם לעברית" Style="{StaticResource GlassButton}" Click="Button_TranslateHebrew" />
                <Button Content="שפר ניסוח" Style="{StaticResource GlassButton}" Click="Button_Improve" />
            </WrapPanel>

            <!-- Result Mode -->
            <TextBlock Text="מצב תוצאה" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="16,16,16,8" />
            <Border Style="{StaticResource StatusCard}">
                <StackPanel Orientation="Vertical">
                    <RadioButton x:Name="RbReplace" Content="החלף במקום (מומלץ)" Foreground="#FFFFFF" Margin="8" Checked="ResultMode_Checked" />
                    <RadioButton x:Name="RbPreview" Content="הצג לפני החלפה" Foreground="#FFFFFF" Margin="8" Checked="ResultMode_Checked" />
                    <RadioButton x:Name="RbCopy" Content="העתק ללוח בלבד" Foreground="#FFFFFF" Margin="8" Checked="ResultMode_Checked" />
                </StackPanel>
            </Border>

            <!-- Shortcuts Card -->
            <TextBlock Text="קיצורי דרך" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="16,16,16,8" />
            <Border Style="{StaticResource StatusCard}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Ctrl + Alt + Z — ⚡ תיקון חכם (מזהה לבד את הכיוון)" Foreground="#4FFF00" Margin="8" FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="Ctrl + Alt + H — הפוך לעברית" Foreground="#BDEFFF" Margin="8" FontSize="12" />
                    <TextBlock Text="Ctrl + Alt + E — הפוך לאנגלית" Foreground="#BDEFFF" Margin="8" FontSize="12" />
                    <TextBlock Text="Ctrl + Alt + T — תרגום אוטומטי" Foreground="#BDEFFF" Margin="8" FontSize="12" />
                    <TextBlock Text="Ctrl + Alt + I — שיפור ניסוח" Foreground="#BDEFFF" Margin="8" FontSize="12" />
                    <TextBlock Text="Ctrl + Alt + Space — תפריט מהיר" Foreground="#BDEFFF" Margin="8" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Features Card -->
            <TextBlock Text="🎉 כל הפונקציונליות בחינם" FontSize="14" FontWeight="Bold" Foreground="#4FFF00" Margin="16,16,16,8" />
            <Border Style="{StaticResource StatusCard}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="✓ המרה עברית ↔ אנגלית" Foreground="#4FFF00" Margin="8" FontSize="12" />
                    <TextBlock Text="✓ תרגום עברית ↔ אנגלית" Foreground="#4FFF00" Margin="8" FontSize="12" />
                    <TextBlock Text="✓ שיפור ניסוח בעברית ובאנגלית" Foreground="#4FFF00" Margin="8" FontSize="12" />
                    <TextBlock Text="✓ כל דבר מתבצע מקומית - ללא עלויות!" Foreground="#BDEFFF" Margin="8" FontSize="12" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- Privacy Card -->
            <TextBlock Text="פרטיות וביטחון" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="16,16,16,8" />
            <Border Style="{StaticResource StatusCard}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="✓ כל משהו מתבצע בלוקאלי בלבד" Foreground="#4FFF00" Margin="8" FontSize="12" />
                    <TextBlock Text="✓ טקסט לא נשמר כברירת מחדל" Foreground="#4FFF00" Margin="8" FontSize="12" />
                    <TextBlock Text="✓ אין שליחה לשרתים חיצוניים" Foreground="#4FFF00" Margin="8" FontSize="12" />
                    <TextBlock Text="✓ לא עובדים על שדות סיסמה" Foreground="#4FFF00" Margin="8" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Window Actions -->
            <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,16">
                <Button Content="הגדרות" Style="{StaticResource GlassButton}" Click="Button_Settings" Width="150" />
                <Button Content="הקטן לרקע" Style="{StaticResource GlassButton}" Click="Button_Minimize" Width="150" />
                <Button Content="✕ סגור לגמרי" Style="{StaticResource GlassButton}" Click="Button_Exit"
                        Width="150" Background="#5A1A2A" BorderBrush="#B03A50" />
            </WrapPanel>

            <!-- Copyright Footer -->
            <Border Background="#0B1F4D" BorderBrush="#2563EB" BorderThickness="0,1,0,0" Padding="16,16,16,16" Margin="0,32,0,0">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock Text="קליקשפה v1.2.1 | עדכון: 07.07.2026"
                               FontSize="13" FontWeight="Bold" Foreground="#38D5FF"
                               TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="© נבנה ותוכנן על ידי גיא רוזנברג 2026"
                               FontSize="12" FontWeight="Bold" Foreground="#4FFF00"
                               TextAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="כל הזכויות שמורות ©"
                               FontSize="11" Foreground="#BDEFFF"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
